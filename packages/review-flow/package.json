{
  "name": "review-flow",
  "version": "0.0.0",
  "description": "Local CLI that reviews code changes with AI agents: find, verify, and rank defects.",
  "keywords": [
    "ai",
    "claude",
    "cli",
    "code-review",
    "cursor"
  ],
  "homepage": "https://github.com/mdjastrzebski/review-flow#readme",
  "license": "MIT",
  "author": "Maciej Jastrzębski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdjastrzebski/review-flow.git",
    "directory": "packages/review-flow"
  },
  "bin": {
    "review-flow": "dist/cli/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build && cp ../../README.md ../../LICENSE .",
    "postpack": "rm README.md LICENSE",
    "release": "release-it",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "install:global": "pnpm pack --out review-flow.tgz && npm install -g ./review-flow.tgz; rm -f review-flow.tgz",
    "uninstall:global": "npm uninstall -g review-flow"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "p-limit": "^7.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "release-it": "^21.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "requireBranch": "main"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "web": true
    },
    "hooks": {
      "before:init": "pnpm -w check",
      "after:bump": "pnpm publish --no-git-checks"
    }
  }
}
